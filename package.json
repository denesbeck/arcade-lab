{
  "name": "arcade-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "npx @biomejs/biome lint --write",
    "format": "npx @biomejs/biome format --write",
    "update": "npx npm-check-updates -u && npm i",
    "lock:sync": "docker run --rm -v \"$PWD\":/app -w /app node:24 npm install --no-audit --no-fund",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-lambda": "^3.1100.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/material": "^9.2.0",
    "@next/mdx": "^16.2.12",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.6",
    "@vercel/speed-insights": "^2.0.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.10",
    "baseline-browser-mapping": "^2.11.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.0.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npx @biomejs/biome check --write",
      "git add"
    ]
  }
}
