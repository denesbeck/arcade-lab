{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    // Type-check only. The server runs straight from source via tsx (see the
    // start/dev scripts and the README's Claude Code config), and blog.ts
    // imports the app's metadata, which sits outside any rootDir this package
    // could declare — so emitting would only produce output nothing consumes.
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
